# FRED API key: used to refresh the ALFRED first-release CPI history.
FRED_API_KEY=

# Valuein API key: refreshes the current Nasdaq-100 fact partitions by manifest snapshot.
VALUEIN_API_KEY=

# Maximum Valuein company partitions to refresh per run (API quota headroom is reserved).
VALUEIN_MAX_PARTITION_DOWNLOADS=100

# Private Cloudflare R2 bucket for persistent caches and monthly snapshots.
CPM_R2_BUCKET=
CPM_R2_ACCOUNT_ID=
CPM_R2_ACCESS_KEY_ID=
CPM_R2_SECRET_ACCESS_KEY=
