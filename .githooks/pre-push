#!/bin/sh
# Auto-select the correct gh account before every push from this repo.
#
# Why: pushes use HTTPS via gh's credential helper, which authenticates as the
# *active* gh account. This personal repo (github.com/rkkautsar/strategy-cpm)
# must push as rkkautsar; the machine default is the work account
# (rkautsar_hopper), so an un-switched push fails with "Repository not found".
# This hook makes the switch automatic so it never has to be remembered.
# Fail-open: any error here must not block the push.
#
# pre-push args: $1 = remote name, $2 = remote URL.

remote_url="$2"
want=""
case "$remote_url" in
  *github.com[:/]rkkautsar/*) want="rkkautsar" ;;
  *github.com*)               want="rkautsar_hopper" ;;
esac

if [ -n "$want" ] && command -v gh >/dev/null 2>&1; then
  active="$(gh auth status --active 2>/dev/null | sed -n 's/.*account \([A-Za-z0-9_-]*\).*/\1/p' | head -n1)"
  if [ "$active" != "$want" ]; then
    gh auth switch --user "$want" >/dev/null 2>&1 || true
  fi
fi
exit 0
