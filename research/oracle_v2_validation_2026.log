        if f"fwd_{a}" in ovr.columns:
            col = ovr[f"fwd_{a}"].dropna()
            print(f"  {a:>8} {col.mean()*100:>+9.2f}% {col.median()*100:>+8.2f}% {(col>0).mean()*100:>5.1f}%")

# ============================================================
# Analysis 3: Sleeve-OFF months (cash regime)
# What was QQQ doing? Did we correctly avoid losses?
# ============================================================
print(f"\n## Sleeve OFF months (cash regime, holding SHV)")
off = df[~df["eligible"]]
print(f"  n = {len(off)}")
off_state_counts = off.groupby("state").size().sort_values(ascending=False)
print(f"  State breakdown:")
for s, n in off_state_counts.items():
    sub = off[off["state"] == s]
    qqq_mean = sub["fwd_QQQ"].mean() * 100
    print(f"    {s}: n={n}, mean QQQ fwd {qqq_mean:+.2f}%")

print(f"\n  Asset comparison (what we held = SHV, vs alternatives):")
for a in ["QQQ", "XLP", "XLV", "XLU", "SPY", "TLT", "GLD", "SHV"]:
    if f"fwd_{a}" in off.columns:
        col = off[f"fwd_{a}"].dropna()
        if len(col) > 0:
            print(f"  {a:>8} mean {col.mean()*100:>+6.2f}%, hit% {(col>0).mean()*100:>5.1f}%")

# ============================================================
# Analysis 4: Pre-eligibility breakdown (why is sleeve off?)
# ============================================================
print(f"\n## Why sleeve was OFF: breakdown")
print(f"  Total months: {len(df)}")
print(f"  Sleeve ON (eligible): {df['eligible'].sum()} ({df['eligible'].mean()*100:.1f}%)")
print(f"  Sleeve OFF total: {(~df['eligible']).sum()} ({(~df['eligible']).mean()*100:.1f}%)")
print(f"    Trend off only: {(~df['trend_ok'] & (df['canary_on'] | df['override'])).sum()}")
print(f"    Canary off & no override only: {((df['trend_ok']) & ~df['canary_on'] & ~df['override']).sum()}")
print(f"    Both off: {(~df['trend_ok'] & ~df['canary_on'] & ~df['override']).sum()}")
"""Test: +-+ state holds XLP/XLV regardless of trend filter.
Compare current rule vs new mechanism-aligned rule on LIVE and EXT.
"""
import sys
sys.path.insert(0, '/Users/rkautsar/personal/scripts/strategy_fcp')
import numpy as np
import pandas as pd
import bull_qqq_live as bql
from fcp_live import load_panel, run_fcp_backtest, sig_13612W
from bull_qqq_live import (BULL_TICKER, CASH_TICKER, COST_BPS_PER_SIDE,
                            _macro_gate, _qqq_trend_ok, _canary_state, _equity_override_threshold)

panel = load_panel(start=pd.Timestamp("1993-01-01"))
daily_rets = panel.ffill().pct_change()

def perf(rets):
    if len(rets) == 0: return {}
    ann_ret = (1 + rets).prod() ** (252 / len(rets)) - 1
    ann_vol = rets.std() * np.sqrt(252)
    sh = ann_ret / ann_vol if ann_vol > 0 else np.nan
    cum = (1 + rets).cumprod()
    dd = (cum / cum.cummax() - 1).min()
    return dict(cagr=ann_ret*100, sh=sh, dd=dd*100)

def run_modified(panel, start, end, defensive_states_bypass_trend=False, cost_bps=COST_BPS_PER_SIDE):
    """If defensive_states_bypass_trend: hold XLP/XLV in +-+ even when trend off."""
    monthly_idx = pd.DataFrame({"x": 1}, index=panel.index).groupby(pd.Grouper(freq="ME")).tail(1)
    sigs = monthly_idx.index[(monthly_idx.index >= start) & (monthly_idx.index <= end)].tolist()
    common = panel.index[(panel.index >= start) & (panel.index <= end)]
    weights_per_day = {t: pd.Series(0.0, index=common) for t in [BULL_TICKER, CASH_TICKER, "XLP", "XLV"]}
    state_per_day = pd.Series("", index=common, dtype=object)

    defensive_count = 0
    defensive_via_bypass = 0
    for i, sig_d in enumerate(sigs):
        mon = panel.loc[:sig_d].resample("ME").last()
        state = _canary_state(mon, sig_d)
        gate_open, _ = _macro_gate(mon, sig_d)
        trend_ok, tdiag = _qqq_trend_ok(mon, sig_d)
        qq = mon[BULL_TICKER].dropna()
        override = False
        if len(qq) >= 13:
            mom = qq.iloc[-1] / qq.iloc[-13] - 1
            thr = _equity_override_threshold(qq, sig_d)
            override = pd.notna(thr) and mom > thr

        is_defensive_state = (state == "+-+")
        canary_eligible = gate_open or override

        if defensive_states_bypass_trend and is_defensive_state and canary_eligible:
            # Hold XLP/XLV basket regardless of trend
            month_weights = {"XLP": 0.5, "XLV": 0.5}
            if not trend_ok:
                defensive_via_bypass += 1
            defensive_count += 1
        elif trend_ok and canary_eligible:
            if is_defensive_state:
                month_weights = {"XLP": 0.5, "XLV": 0.5}
                defensive_count += 1
            else:
                month_weights = {BULL_TICKER: 1.0}
        else:
            month_weights = {CASH_TICKER: 1.0}

        future = common[common > sig_d]
        if len(future) < 2: continue
        apply_from = future[1]
        if i + 1 < len(sigs):
            ns = sigs[i + 1]
            nf = common[common > ns]
            end_apply = nf[1] if len(nf) >= 2 else common[-1]
        else:
            end_apply = common[-1] + pd.Timedelta(days=1)
        mask = (common >= apply_from) & (common < end_apply)
        for t, w in month_weights.items():
            weights_per_day[t].loc[mask] = w
        label = "+".join(f"{t}:{w:.2f}" for t, w in sorted(month_weights.items()))
        state_per_day.loc[mask] = label

    port = pd.Series(0.0, index=common)
    for t, w_s in weights_per_day.items():
        if t in daily_rets.columns:
            port = port + daily_rets[t].reindex(common).fillna(0.0) * w_s
    if cost_bps > 0:
        la = state_per_day.values
        flips = np.where(la[1:] != la[:-1])[0] + 1
        for f in flips:
            port.iloc[f] -= 2.0 * cost_bps / 10000.0
    return port, defensive_count, defensive_via_bypass

for window_name, start in [("LIVE 18y", pd.Timestamp("2008-01-01")),
                            ("EXT 32y", pd.Timestamp("1994-01-01"))]:
    end = pd.Timestamp.today().normalize()
    print(f"\n## {window_name}: {start.date()} -> {end.date()}")
    fcp, _ = run_fcp_backtest(panel, start, end)
    
    for label, bypass in [("Current (trend gates defensive)", False),
                          ("NEW (+-+ bypasses trend)", True)]:
        bull, n_def, n_bypass = run_modified(panel, start, end, defensive_states_bypass_trend=bypass)
        common = fcp.index.intersection(bull.index)
        blend = 0.6 * fcp.reindex(common) + 0.4 * bull.reindex(common)
        p_b = perf(bull.reindex(common))
        p_bl = perf(blend)
        bypass_note = f" (+{n_bypass} bypass-driven months)" if bypass else ""
        print(f"  {label:<40} | BULL Sh {p_b['sh']:.3f} CAGR {p_b['cagr']:.2f}% | 60/40 Sh {p_bl['sh']:.3f} CAGR {p_bl['cagr']:.2f}%{bypass_note}")
    print(f"  +-+ months total: {n_def}")
