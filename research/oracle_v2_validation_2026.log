"""Test full rule: defensive basket when canary off + trend OK (replacing SHV)."""
import sys
sys.path.insert(0, '/Users/rkautsar/personal/scripts/strategy_fcp')
import numpy as np
import pandas as pd
import bull_qqq_live as bql
from fcp_live import load_panel, run_fcp_backtest
from bull_qqq_live import (BULL_TICKER, CASH_TICKER, COST_BPS_PER_SIDE,
                            _macro_gate, _qqq_trend_ok, _canary_state, _equity_override_threshold)

panel = load_panel(start=pd.Timestamp("1993-01-01"))
daily_rets = panel.ffill().pct_change()

def perf(rets):
    if len(rets) == 0: return {}
    ann_ret = (1 + rets).prod() ** (252 / len(rets)) - 1
    ann_vol = rets.std() * np.sqrt(252)
    sh = ann_ret / ann_vol if ann_vol > 0 else np.nan
    cum = (1 + rets).cumprod()
    dd = (cum / cum.cummax() - 1).min()
    return dict(cagr=ann_ret*100, sh=sh, dd=dd*100)

def run_full(panel, start, end, defensive_when_canary_off=None, cost_bps=COST_BPS_PER_SIDE):
    """Build sleeve. defensive_when_canary_off:
       None = current (use SHV cash when canary off)
       dict = use this basket when trend_ok AND canary_off AND not override
    """
    monthly_idx = pd.DataFrame({"x": 1}, index=panel.index).groupby(pd.Grouper(freq="ME")).tail(1)
    sigs = monthly_idx.index[(monthly_idx.index >= start) & (monthly_idx.index <= end)].tolist()
    common = panel.index[(panel.index >= start) & (panel.index <= end)]
    all_tickers = {BULL_TICKER, CASH_TICKER, "XLP", "XLV", "XLU"}
    weights_per_day = {t: pd.Series(0.0, index=common) for t in all_tickers}
    state_per_day = pd.Series("", index=common, dtype=object)
    n_defensive_path = 0

    for i, sig_d in enumerate(sigs):
        mon = panel.loc[:sig_d].resample("ME").last()
        state = _canary_state(mon, sig_d)
        gate_open, _ = _macro_gate(mon, sig_d)
        trend_ok, _ = _qqq_trend_ok(mon, sig_d)
        qq = mon[BULL_TICKER].dropna()
        override = False
        if len(qq) >= 13:
            mom = qq.iloc[-1] / qq.iloc[-13] - 1
            thr = _equity_override_threshold(qq, sig_d)
            override = pd.notna(thr) and mom > thr

        if trend_ok and (gate_open or override):
            # Bull path
            if state == "+-+":
                month_weights = {"XLP": 0.5, "XLV": 0.5}
            else:
                month_weights = {BULL_TICKER: 1.0}
        elif trend_ok and not gate_open and not override and defensive_when_canary_off is not None:
            # NEW: defensive path when canary off but trend still ok
            month_weights = dict(defensive_when_canary_off)
            n_defensive_path += 1
        else:
            month_weights = {CASH_TICKER: 1.0}

        future = common[common > sig_d]
        if len(future) < 2: continue
        apply_from = future[1]
        if i + 1 < len(sigs):
            ns = sigs[i + 1]
            nf = common[common > ns]
            end_apply = nf[1] if len(nf) >= 2 else common[-1]
        else:
            end_apply = common[-1] + pd.Timedelta(days=1)
        mask = (common >= apply_from) & (common < end_apply)
        for t, w in month_weights.items():
            weights_per_day[t].loc[mask] = w
        label = "+".join(f"{t}:{w:.2f}" for t, w in sorted(month_weights.items()))
        state_per_day.loc[mask] = label

    port = pd.Series(0.0, index=common)
    for t, w_s in weights_per_day.items():
        if t in daily_rets.columns:
            port = port + daily_rets[t].reindex(common).fillna(0.0) * w_s
    if cost_bps > 0:
        la = state_per_day.values
        flips = np.where(la[1:] != la[:-1])[0] + 1
        for f in flips:
            port.iloc[f] -= 2.0 * cost_bps / 10000.0
    return port, n_defensive_path

for window_name, start in [("LIVE 18y", pd.Timestamp("2008-01-01")),
                            ("EXT 32y", pd.Timestamp("1994-01-01"))]:
    end = pd.Timestamp.today().normalize()
    print(f"\n## {window_name}: {start.date()} -> {end.date()}")
    fcp, _ = run_fcp_backtest(panel, start, end)
    
    variants = [
        ("Current (SHV when canary off)", None),
        ("New: XLU when canary off", {"XLU": 1.0}),
        ("New: XLP when canary off", {"XLP": 1.0}),
        ("New: XLP/XLU 50/50 basket", {"XLP": 0.5, "XLU": 0.5}),
        ("New: XLP/XLV/XLU 1/3 each", {"XLP": 1/3, "XLV": 1/3, "XLU": 1/3}),
        ("New: 60/40 XLU/SHV (hedged)", {"XLU": 0.6, "SHV": 0.4}),
    ]
    print(f"  {'Variant':<35} | BULL Sh  CAGR | 60/40 Sh  CAGR  MaxDD | n_def")
    for label, alt in variants:
        bull, n_def = run_full(panel, start, end, alt)
        common = fcp.index.intersection(bull.index)
        blend = 0.6 * fcp.reindex(common) + 0.4 * bull.reindex(common)
        p_b = perf(bull.reindex(common))
        p_bl = perf(blend)
        print(f"  {label:<35} | {p_b['sh']:.3f}  {p_b['cagr']:.2f}% | {p_bl['sh']:.3f}  {p_bl['cagr']:.2f}%  {p_bl['dd']:.1f}% | n={n_def}")
