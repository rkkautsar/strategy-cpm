from fcp_live import load_panel, sig_13612W

panel = load_panel(start=pd.Timestamp("1993-01-01"))
monthly = panel.resample("ME").last()
start, end = pd.Timestamp("2008-01-01"), pd.Timestamp.today().normalize()

# Build full diagnostic table
print("## Building per-month diagnostics (LIVE 18y)")
monthly_idx = pd.DataFrame({"x": 1}, index=panel.index).groupby(pd.Grouper(freq="ME")).tail(1)
sigs = monthly_idx.index[(monthly_idx.index >= start) & (monthly_idx.index <= end)].tolist()

records = []
for sig_d in sigs:
    mon = panel.loc[:sig_d].resample("ME").last()
    state = bql._canary_state(mon, sig_d)
    if state is None:
        continue
    gate_open, _ = bql._macro_gate(mon, sig_d)
    trend_ok, tdiag = bql._qqq_trend_ok(mon, sig_d)
    qq = mon[bql.BULL_TICKER].dropna()
    if len(qq) < 13:
        continue
    mom12_1 = qq.iloc[-1] / qq.iloc[-13] - 1
    thr = bql._equity_override_threshold(qq, sig_d)
    override = pd.notna(thr) and mom12_1 > thr
    eligible = trend_ok and (gate_open or override)
    
    # Forward returns for candidate assets
    fwd = {}
    for asset in ["QQQ", "XLP", "XLV", "XLU", "SPY", "SHV", "TLT", "GLD"]:
        if asset in monthly.columns:
            s = monthly[asset].dropna().loc[sig_d:]
            fwd[asset] = s.iloc[1]/s.iloc[0] - 1 if len(s) >= 2 else np.nan
    
    records.append({
        "date": sig_d, "state": state, "trend_ok": trend_ok,
        "canary_on": gate_open, "override": override, "eligible": eligible,
        **{f"fwd_{a}": v for a, v in fwd.items()}
    })

df = pd.DataFrame(records).set_index("date").dropna(subset=["fwd_QQQ"])
print(f"  {len(df)} months analyzed")

# ============================================================
