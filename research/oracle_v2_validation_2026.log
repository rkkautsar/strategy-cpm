states = ["+++", "++-", "+-+", "+--", "-++", "-+-", "--+", "---"]
for s in states:
    sub = df[(df["state"] == s) & df["eligible"]]
    if len(sub) == 0:
        print(f"  {s:>6} {0:>4} | {'-':>7} {'-':>7} {'-':>7} {'-':>7} {'-':>7} | (no eligible)")
        continue
    means = {a: sub[f"fwd_{a}"].mean() * 100 for a in ["QQQ", "XLP", "XLV", "XLU", "SPY"]}
    best_asset = max(means, key=means.get)
    diff = means[best_asset] - means["QQQ"]
    print(f"  {s:>6} {len(sub):>4} | {means['QQQ']:>+6.2f}% {means['XLP']:>+6.2f}% {means['XLV']:>+6.2f}% {means['XLU']:>+6.2f}% {means['SPY']:>+6.2f}% | {best_asset:<8} {diff:>+8.2f}%")

# ============================================================
